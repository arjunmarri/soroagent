{
  "manifest_version": 3,
  "name": "SoroAgent",
  "short_name": "SoroAgent",
  "version": "2.9.0",
  "description": "AI assistant for any web page, powered by your local LLM (Ollama, LM Studio…) or your own API key (Claude, OpenAI, Gemini…). Summarize, ask and save.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/sw.js",
    "scripts": [
      "shared/config.js",
      "shared/markdown.js",
      "shared/prompts.js",
      "shared/snippets.js",
      "shared/backup.js",
      "background/llm.js",
      "background/recommend.js",
      "background/secrets.js",
      "background/research.js",
      "background/jobs.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/config.js",
        "shared/markdown.js",
        "shared/prompts.js",
        "prompts/*.js",
        "shared/snippets.js",
        "sites/registry.js",
        "sites/*.js",
        "content/extract.js",
        "shared/brand.js",
        "content/styles.js",
        "content/launcher.js",
        "content/declutter.js",
        "content/assistant.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SoroAgent: open on this page (Alt+Shift+K)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open or close the assistant on the current page"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sorotrack@arjunmarri.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
